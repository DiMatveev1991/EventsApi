{
  "ConnectionStrings": {
    "BookingsDatabase": "Host=localhost;Port=5435;Database=bookings_db;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "BookingProcessing": {
    "ConfirmationDelay": "00:00:00",
    "PollingInterval": "00:00:00.500"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EventsSystem",
    "Audience": "EventsSystem.Clients"
  },
  "OpenTelemetry": {
    "ServiceName": "bookings-service"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
