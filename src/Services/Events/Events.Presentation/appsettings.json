{
  "ConnectionStrings": {
    "EventsDatabase": "Host=localhost;Port=5434;Database=events_db;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "EventTtlSeconds": 300,
    "TopEventsTtlSeconds": 60
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "EventsSystem",
    "Audience": "EventsSystem.Clients"
  },
  "OpenTelemetry": {
    "ServiceName": "events-service"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
