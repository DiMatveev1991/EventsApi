<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>EventsApi.Presentation</RootNamespace>
    <AssemblyName>EventsApi.Presentation</AssemblyName>
  </PropertyGroup>

  <!--
    Presentation — точка входа (веб-проект) и composition root.
    Зависит от Application и Infrastructure; Domain доступен транзитивно.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <!--
      Нужен инструменту dotnet-ef: startup-проект должен ссылаться на Design,
      чтобы генерировать/применять миграции (сами миграции живут в Infrastructure).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventsApi.Application\EventsApi.Application.csproj" />
    <ProjectReference Include="..\EventsApi.Infrastructure\EventsApi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
